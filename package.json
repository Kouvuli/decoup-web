{
  "name": "decoup-web",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps/web/src packages",
    "check": "npm run typecheck && npm run boundaries"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dependency-cruiser": "17.4.3",
    "typescript": "5.9.3"
  }
}
