#!/bin/sh
set -eu
subject=$(head -n 1 "$1")
if ! printf '%s\n' "$subject" | LC_ALL=C grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?!?: DE-[0-9]+ [^[:space:]].*$'; then
    echo 'Use Conventional Commits with a ticket: type(scope): DE-123 description' >&2
    exit 1
fi
